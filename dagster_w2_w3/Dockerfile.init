FROM alpine:latest

# Get the tools we need: curl for downloads and bash for scripting
RUN apk add --no-cache curl bash

# Download the lakeFS CLI tool (lakectl) to manage repositories
RUN curl -LO https://github.com/treeverse/lakeFS/releases/download/v1.30.0/lakefs_1.30.0_linux_amd64.tar.gz \
    && tar -xzf lakefs_1.30.0_linux_amd64.tar.gz \
    && mv lakefs /usr/local/bin/lakectl \
    && rm lakefs_1.30.0_linux_amd64.tar.gz

# Add the setup script that will initialize lakeFS and load data
COPY scripts/setup_lakefs.sh /setup.sh
RUN chmod +x /setup.sh

# These can be overridden when running the container, but we provide reasonable defaults
ENV LAKECTL_SERVER_ENDPOINT_URL="http://lakefs:8000"
ENV LAKECTL_CREDENTIALS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
ENV LAKECTL_CREDENTIALS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

# Execute the initialization script
CMD ["/bin/sh", "/setup.sh"]